# Kumbara environment. Copy to .env and fill in real values. Never commit .env.
# Every variable the app or the spikes read is listed here with a placeholder.

# --- Anchor (TR Mock Anchor, Partner API + SEP door) -------------------------
# Base URL of the anchor. Endpoints and the USDC issuer are discovered from
# <ANCHOR_BASE_URL>/.well-known/stellar.toml and /health, never hardcoded.
ANCHOR_BASE_URL=https://tr-mock-anchor.fly.dev
# Partner API key (trma_test_...). Server-side only; never shipped to the browser.
ANCHOR_API_KEY=trma_test_replace_me

# --- Sembol Cloud (fee-sponsoring relay in front of OpenZeppelin Relayer) ----
# Relay endpoint the app posts signed { func, auth } payloads to for fee bumping.
SEMBOL_CLOUD_URL=https://relay.example.com
# Project identifier registered with Sembol Cloud.
SEMBOL_PROJECT_ID=kumbara
# Project API key for Sembol Cloud. Server-side only.
SEMBOL_PROJECT_KEY=sk_replace_me

# --- Stellar ------------------------------------------------------------------
# "testnet" or "public". Every balance and explorer link is labeled with it.
STELLAR_NETWORK=testnet
# Stellar RPC endpoint for the network above.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# --- DeFindex -----------------------------------------------------------------
# Contract ID (C...) of the DeFindex vault that accepts the anchor's USDC.
DEFINDEX_VAULT_ID=CREPLACE_ME

# --- Soroswap -----------------------------------------------------------------
# "true" only if the anchor's payout asset must be swapped into the vault asset.
SOROSWAP_ENABLED=false

# --- Booth mode ---------------------------------------------------------------
# Unix timestamp (seconds) the booth counter starts counting from.
BOOTH_START_TS=1758268800

# --- Mainnet demo (presenter-only) -------------------------------------------
# "true" enables the presenter-only mainnet path. Keep false for the booth.
MAINNET_DEMO_ENABLED=false
