# Kumbara environment. Copy to .env and fill in real values. Never commit .env.
# Every variable the app or the spikes read is listed here with a placeholder.

# --- Anchor (TR Mock Anchor, Partner API + SEP door) -------------------------
# Base URL of the anchor. Endpoints and the USDC issuer are discovered from
# <ANCHOR_BASE_URL>/.well-known/stellar.toml and /health, never hardcoded.
ANCHOR_BASE_URL=https://tr-mock-anchor.fly.dev
# Partner API key (trma_test_...). Server-side only; never shipped to the browser.
ANCHOR_API_KEY=trma_test_replace_me

# --- Sembol Cloud (fee-sponsoring relay in front of OpenZeppelin Relayer) ----
# Relay endpoint that receives signed { func, auth } payloads and fee-bumps them.
# Until Sembol Cloud is live this may be an OpenZeppelin Relayer Channels
# service URL (e.g. https://channels.openzeppelin.com/testnet).
SEMBOL_CLOUD_URL=https://relay.example.com
# Project identifier registered with Sembol Cloud.
SEMBOL_PROJECT_ID=kumbara
# Project API key for Sembol Cloud (or the Channels API key). Server-side only.
SEMBOL_PROJECT_KEY=sk_replace_me

# --- Stellar ------------------------------------------------------------------
# "testnet" or "public". Every balance and explorer link is labeled with it.
STELLAR_NETWORK=testnet
# Same value for the browser bundle (picks the Sembol contract preset).
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Optional RPC override for the browser (defaults to the preset's RPC).
NEXT_PUBLIC_STELLAR_RPC_URL=
# Stellar RPC endpoint for the network above.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Optional Horizon endpoint (defaults to the SDF Horizon for STELLAR_NETWORK).
STELLAR_HORIZON_URL=

# --- DeFindex -----------------------------------------------------------------
# Contract ID (C...) of the DeFindex vault that accepts the anchor's USDC.
DEFINDEX_VAULT_ID=CREPLACE_ME
# Optional: DeFindex factory used by the spike to deploy a vault when none fits
# (defaults to the public testnet factory).
DEFINDEX_FACTORY_ID=

# --- Soroswap -----------------------------------------------------------------
# "true" only if the anchor's payout asset must be swapped into the vault asset.
SOROSWAP_ENABLED=false
# Optional: Soroswap router/factory overrides (default to the public testnet ids).
SOROSWAP_ROUTER_ID=
SOROSWAP_FACTORY_ID=
# Optional: Soroswap aggregator API key (sk_...), only used when swapping is on.
SOROSWAP_API_KEY=

# --- Landing accounts (on-ramp / off-ramp path) -----------------------------
# "landing" (default): deposits land on an ownerless pre-authorized classic
# account and are forwarded to the kumbara. "direct": only if the anchor ever
# delivers USDC to contract addresses.
ONRAMP_MODE=landing
# Same for withdrawals: "landing" (default) or "direct".
OFFRAMP_MODE=landing
# Classic account (S...) that sponsors landing-account reserves (2.5 XLM per
# in-flight deposit, returned at cleanup) and pays their setup fees. Keep its
# balance small (the app refuses below 3 XLM and warns above 100 XLM). It never
# holds user funds and is never a signer on a kumbara. Server-side only.
SPONSOR_SECRET=SREPLACE_ME

# --- Reflector (USD/TRY for display) -----------------------------------------
# Optional overrides: Stellar mainnet RPC and the Reflector FX oracle contract.
REFLECTOR_RPC_URL=
REFLECTOR_FX_ORACLE=

# --- Booth mode ---------------------------------------------------------------
# Unix timestamp (seconds) the booth counter starts counting from.
BOOTH_START_TS=1758268800

# --- Mainnet demo (presenter-only) -------------------------------------------
# "true" enables the presenter-only mainnet path. Keep false for the booth.
MAINNET_DEMO_ENABLED=false
