{
  "name": "kumbara",
  "version": "0.0.0",
  "private": true,
  "description": "Kumbara by Sembol: a self-custodial USDC piggy bank on Stellar for Turkish users.",
  "license": "MIT",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "rm -rf .next/types .next/dev/types && tsc --noEmit",
    "spike:sep6": "node --env-file=.env --import tsx spikes/sep6.ts",
    "spike:soroswap": "node --env-file=.env --import tsx spikes/soroswap.ts",
    "spike:relay": "node --env-file=.env --import tsx spikes/relay.ts",
    "spike:all": "pnpm spike:relay && pnpm spike:sep6 && pnpm spike:soroswap",
    "e2e:onboard": "node scripts/e2e-onboard.mjs",
    "test": "NODE_OPTIONS=--expose-gc vitest run",
    "demo:deposit": "node --env-file=.env --import tsx scripts/demo-deposit.ts",
    "e2e:recover": "node --env-file=.env scripts/e2e-recover.mjs",
    "e2e:proof": "node --env-file=.env scripts/e2e-proof.mjs",
    "e2e:goal": "node --env-file=.env scripts/e2e-goal.mjs",
    "e2e:invite": "node --env-file=.env scripts/e2e-invite.mjs",
    "e2e:deposit": "node --env-file=.env scripts/e2e-deposit.mjs",
    "e2e:leave": "E2E_LEAVE_AFTER_IBAN=1 node --env-file=.env scripts/e2e-deposit.mjs",
    "e2e:autobank": "E2E_AUTOBANK=1 node --env-file=.env scripts/e2e-deposit.mjs",
    "e2e:withdraw": "node --env-file=.env scripts/e2e-withdraw.mjs",
    "e2e:address": "node --env-file=.env scripts/e2e-address.mjs",
    "e2e:optout": "node --env-file=.env scripts/e2e-optout.mjs",
    "lint": "eslint .",
    "e2e:booth": "node --env-file=.env scripts/e2e-booth.mjs",
    "e2e:stats": "node scripts/e2e-stats.mjs",
    "e2e:funnel": "node scripts/e2e-funnel.mjs",
    "reconcile:in-wallet": "node --env-file=.data/turso.prod.env scripts/reconcile-in-wallet.mjs",
    "e2e:failures": "node scripts/e2e-failures.mjs",
    "e2e:all": "pnpm e2e:onboard && pnpm e2e:recover && pnpm e2e:proof && pnpm e2e:goal && pnpm e2e:invite && pnpm e2e:deposit && pnpm e2e:leave && pnpm e2e:autobank && pnpm e2e:withdraw && pnpm e2e:address && pnpm e2e:booth && pnpm e2e:stats && pnpm e2e:funnel && pnpm e2e:failures",
    "demo:record": "node --env-file=.env scripts/demo-record.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "playwright": "~1.62.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@libsql/client": "^0.18.0",
    "@sembol/passkey-react": "0.4.0",
    "@stellar/stellar-sdk": "^16.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "^16.3.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "smart-account-kit": "0.6.2",
    "tw-animate-css": "^1.4.0"
  },
  "type": "module"
}
